# Miner Client Configuration Template
# Copy this file to .env and fill in the values

# Docker Image
DOCKER_IMAGE=ghcr.io/ault-blockchain/aultmined

# Chain Configuration
CHAIN_GRPC=localhost:9090
CHAIN_RPC=tcp://localhost:26657
CHAIN_ID=ault_4400-1

# VRF Keys (generated by setup_vrf_key.sh)
# Ed25519 private keys (64 bytes hex, RFC8032 format)
# Comma-separated, one per operator
MINER_VRF_KEYS=

# Mining Configuration
# Max submissions per batch (0 = unlimited, submit all wins in one tx)
MINER_BATCH_SIZE=100

# API port base (miner-1 -> BASE+1, miner-2 -> BASE+2, etc.)
# Default: 8079 (so miner-1 -> 8080)
# MINER_BASE_PORT=8079
