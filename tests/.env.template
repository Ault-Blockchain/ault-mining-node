# Miner Client Configuration Template
# Copy this file to .env and fill in the values

# Docker Image
DOCKER_IMAGE=ghcr.io/ault-blockchain/aultmined

# Chain Configuration
CHAIN_GRPC=localhost:9090
CHAIN_RPC=tcp://localhost:26657
CHAIN_ID=ault_20904-1

# VRF Keys (generated by setup_vrf_key.sh)
# Ed25519 private keys (64 bytes hex, RFC8032 format)
# One per operator, indexed from 0
MINER_VRF_KEY_0=
MINER_VRF_KEY_1=
MINER_VRF_KEY_2=
MINER_VRF_KEY_3=

# Operator Mnemonics (one per operator, indexed from 0)
OPERATOR_MNEMONIC_0=
OPERATOR_MNEMONIC_1=
OPERATOR_MNEMONIC_2=
OPERATOR_MNEMONIC_3=

# Minter Mnemonics (one per minter, indexed from 0)
MINTER_MNEMONIC_0=
MINTER_MNEMONIC_1=
MINTER_MNEMONIC_2=
MINTER_MNEMONIC_3=

# License Holder Mnemonics (one per holder, indexed from 0)
LICENSE_HOLDER_MNEMONIC_0=
LICENSE_HOLDER_MNEMONIC_1=
LICENSE_HOLDER_MNEMONIC_2=
LICENSE_HOLDER_MNEMONIC_3=
LICENSE_HOLDER_MNEMONIC_4=
LICENSE_HOLDER_MNEMONIC_5=
LICENSE_HOLDER_MNEMONIC_6=
LICENSE_HOLDER_MNEMONIC_7=
LICENSE_HOLDER_MNEMONIC_8=
LICENSE_HOLDER_MNEMONIC_9=

# Mining Configuration
# Max submissions per batch (0 = unlimited, submit all wins in one tx)
MINER_BATCH_SIZE=100

# API port base (miner-1 -> BASE+1, miner-2 -> BASE+2, etc.)
# Default: 8079 (so miner-1 -> 8080)
# MINER_BASE_PORT=8079
