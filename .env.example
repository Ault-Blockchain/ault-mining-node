# Ault Miner Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Required Variables
# ===================

# Operator private key (hex, 32 bytes) - secp256k1 key for signing transactions
# This is the private key of the account that owns licenses and submits mining transactions
MINER_OPERATOR_KEY=8A36C69D940A92FCEA94B36D0F2928C7A0EE19A90073EDA769693298DFA9603B  # dev3

# VRF private key (hex, 64 bytes) - Ed25519 key in RFC8032 format for VRF proofs
# This key is used to generate verifiable random outputs for mining
# IMPORTANT: This must be a 64-byte Ed25519 private key, NOT a 32-byte secp256k1 key
MINER_VRF_KEY=726749cd171a45f6a5d2d57fc2fed2f35e1aa38422a982b65860149cc9a8b71ed007215ad5f4965a05230d7f2be88982fa4d5c08314275300d91a871c3e7dae1
# VRF Public key: d007215ad5f4965a05230d7f2be88982fa4d5c08314275300d91a871c3e7dae1

# ===================
# Optional Variables
# ===================

# Chain configuration (defaults shown)
CHAIN_GRPC=localhost:9090
# gRPC transport security: auto (try TLS, fall back to plaintext), true (force TLS), false (force plaintext)
CHAIN_GRPC_TLS=auto
CHAIN_RPC=tcp://localhost:26657
CHAIN_ID=ault_20904-1

# API server port (default: 8080)
MINER_API_PORT=8080
