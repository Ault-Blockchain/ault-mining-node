# Miner Client Configuration Template
# Copy this file to .env and fill in the values

# Docker Image
DOCKER_IMAGE=ghcr.io/ault-blockchain/minerd

# Chain Configuration (shared across all miners)
CHAIN_GRPC=localhost:9090
CHAIN_RPC=tcp://localhost:26657
CHAIN_ID=ault_4400-1

# Miner Keys (comma-separated arrays)
# Each index corresponds to miner-1, miner-2, etc.
# MINER_OPERATOR_KEYS: secp256k1 private keys (32 bytes hex)
# MINER_VRF_KEYS: Ed25519 private keys (64 bytes hex, RFC8032 format)
MINER_OPERATOR_KEYS=
MINER_VRF_KEYS=

# License Setup Configuration (for setup_licenses.sh)
# Number of licenses to mint per operator
LICENSE_PER_OPERATOR=1
# Minter private key (secp256k1, 32 bytes hex, must have minter permission)
MINTER_KEY=
