# Miner Client Configuration Template
# Copy this file to .env and fill in the values

# Docker Image
DOCKER_IMAGE=ghcr.io/ault-blockchain/aultmined

# Chain Configuration (shared across all miners)
CHAIN_GRPC=localhost:9090
CHAIN_RPC=tcp://localhost:26657
CHAIN_ID=ault_20904-1

# Miner Keys (comma-separated arrays)
# Each index corresponds to miner-1, miner-2, etc.
# MINER_OPERATOR_KEYS: secp256k1 private keys (32 bytes hex)
# MINER_VRF_KEYS: Ed25519 private keys (64 bytes hex, RFC8032 format)
MINER_OPERATOR_KEYS=
MINER_VRF_KEYS=

# Mining Configuration
# Max submissions per batch (0 = unlimited, submit all wins in one tx)
MINER_BATCH_SIZE=100

# License Setup Configuration (for setup_licenses.sh)
# Number of licenses to mint per operator
LICENSE_PER_OPERATOR=1
# Minter private key (secp256k1, 32 bytes hex, must have minter permission)
MINTER_KEY=

# Delegation Setup Configuration (for setup_delegation.sh)
# License holder private key (receives 10,000 licenses, then delegates to operators)
LICENSE_HOLDER_KEY=

# Fee granter address (module address that pays fees)
FEEGRANT_MODULE_ADDR=ault140h2ttm4yx8tlxeyg3lh8u787lqzrk28gpqkvq
